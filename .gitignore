# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv/
**/.venv/

# uv (lock stays at repo root only)
gpu-clahe/uv.lock
yolo-lab/uv.lock
dataset-transform/uv.lock

# gpu-clahe data & outputs
gpu-clahe/dataset/
gpu-clahe/result/

# night-iris data & outputs
night-iris/data/
night-iris/result/
night-iris/uv.lock

# yolo-lab data, downloaded COCO weights, and training outputs
yolo-lab/runs/
yolo-lab/experiments/
yolo-lab/datasets
yolo-lab/yolo-coco/
yolo-lab/fine_tuned_ldr/

# Engines are bound to this GPU. ONNX is an export intermediate.
*.engine
*.onnx
*.weights

# Ignore weight files, then re-include the checkpoints Night-Iris loads.
# yolo26l-sem.pt is the Ultralytics sem start (also copied as the object model).
# yolo26l-sem-shadow-2.pt is the SBU bright/dark model used at inference.
*.pt
!night-iris/model/yolo26l-sem.pt
!night-iris/model/yolo26l-sem-object.pt
!night-iris/model/yolo26l-sem-shadow-2.pt

# Charts / local artifacts. The architecture figure is part of the root README.
*.png
*.jpg
!docs/architecture.png

# Env secrets
.env
.env.*

# Local writing (not published with the code)
.docs/

# IDE / OS / agent tooling
.cursor/
.idea/
.vscode/
.DS_Store
Thumbs.db
